# Copy to .env.local and adjust. Never commit the real .env.local file.

# Base URL of the BioStor API (the FastAPI backend).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public HTTPS origin of this frontend (no trailing slash).
# Required in production so social-preview (og:image) URLs are absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
