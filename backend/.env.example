# Copy to .env and adjust. Never commit the real .env file.

# --- Core ---
DEBUG=True
API_V1_STR=/api/v1

# --- Database (PostgreSQL in production, SQLite for local dev) ---
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/biostor
DATABASE_URL=sqlite+aiosqlite:///./biostore.db

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# JSON array (pydantic-settings decodes list env vars as JSON):
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Email (unset => emails logged to console) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
EMAIL_FROM=noreply@biostor.app
EMAIL_FROM_NAME=BioStor

# --- Storage ---
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# S3 or Supabase storage:
# S3_BUCKET=...
# S3_REGION=...
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# SUPABASE_URL=...
# SUPABASE_KEY=...
# SUPABASE_BUCKET=biostor

# --- Rate limiting ---
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

# --- Seeding / admin ---
SEED_DEMO_DATA=True
ADMIN_EMAIL=admin@biostor.app
# CHANGE THIS before deploying anywhere public.
ADMIN_PASSWORD=Admin@12345
